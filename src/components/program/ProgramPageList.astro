---
import type { FestivalDay, FogonesDay } from '../../types/festival';
interface Props {
  days: readonly (FestivalDay | FogonesDay)[];
  venue: string;
  linked?: boolean;
}
const { days, venue, linked = true } = Astro.props;
---

{days.map((day) => (
  <section class="program-page-day" aria-labelledby={`program-${day.date}`}>
    <h2 id={`program-${day.date}`}>
      {linked ? (
        <a href={`/programacion/${day.date}/`}>
          {day.weekday} {day.day} de octubre
        </a>
      ) : (
        `${day.weekday} ${day.day} de octubre`
      )}
    </h2>
    <p>{'note' in day && day.note ? day.note : `Programación anunciada para ${venue}.`}</p>
    <ol class="program-page-list">
      {day.acts.map((act) => (
        <li>
          <time datetime={`${act.civilDate}T${act.time}:00-03:00`}>{act.time}</time>
          <div>
            <strong>{act.name}</strong>
            {act.category && <small> · {act.category}</small>}
          </div>
        </li>
      ))}
    </ol>
  </section>
))}
