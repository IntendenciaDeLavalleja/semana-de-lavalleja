---
import { navigation } from '../../config/navigation';
import BrandLogo from '../brand/BrandLogo.astro';
import { AgendaTrigger } from '../islands/AgendaTrigger';
import { MobileMenu } from '../islands/MobileMenu';
import SocialLinks from './SocialLinks.astro';
---

<a class="skip-link" href="#contenido">
  Saltar al contenido
</a>
<header class="site-header" id="site-header">
  <a class="brand" href="/#inicio" aria-label="Semana de Lavalleja, ir al inicio">
    <BrandLogo />
  </a>
  <nav class="desktop-nav" aria-label="Navegación principal">
    {navigation
      .filter((item) => item.desktop !== false)
      .map((item) => (
        <a
          href={item.href}
          class:list={{ 'nav-external': item.external }}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          {item.label}
          {(item.number === '03' || item.external) && <span aria-hidden="true">↗</span>}
        </a>
      ))}
  </nav>
  <SocialLinks class="header-social" />
  <div class="header-actions">
    <AgendaTrigger client:load />
    <MobileMenu client:load />
  </div>
</header>
