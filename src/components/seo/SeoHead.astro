---
import { siteConfig } from '../../config/site';
import { absoluteUrl, getBuildSite } from '../../lib/urls';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  pathname?: string | undefined;
  imageAlt?: string | undefined;
}
const {
  title = `${siteConfig.name} · La Fiesta de Nuestros Pueblos`,
  description = siteConfig.description,
  pathname = Astro.url.pathname,
  imageAlt = 'Paisaje gráfico de la 53.ª Semana de Lavalleja',
} = Astro.props;
const build = getBuildSite();
const canonical = absoluteUrl(pathname, build.url);
const image = absoluteUrl(siteConfig.image, build.url);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={build.indexable ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'}
/>
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={siteConfig.ogLocale} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(siteConfig.imageWidth)} />
<meta property="og:image:height" content={String(siteConfig.imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
