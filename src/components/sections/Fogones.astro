---
import { festival } from '../../data/festival';

const { fogones } = festival;
const civilDayLabel = (date: string) =>
  new Intl.DateTimeFormat('es-UY', {
    weekday: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  })
    .format(new Date(`${date}T12:00:00Z`))
    .toLocaleUpperCase('es-UY');
---

<section class="fogones-section dark-section" id="fogones" aria-labelledby="fogones-title">
  <div class="night-stars" aria-hidden="true"></div>
  <div class="ember-field" aria-hidden="true"></div>
  <div class="fire-glow" aria-hidden="true"></div>
  <div class="section-kicker reveal">
    <span>03 / LA NOCHE DE LOS FOGONES</span>
    <span>CERRO ARTIGAS · MINAS</span>
  </div>
  <div class="fogones-content">
    <div class="fogones-pretitle reveal">
      <span class="spark-mark">✳</span> MUCHOS PAGOS, UN SOLO FOGÓN.
    </div>
    <h2 id="fogones-title" class="reveal">
      LA NOCHE
      <br />
      NOS <em>ENCUENTRA.</em>
    </h2>
    <div class="fogones-dates reveal">
      <span>17</span>
      <svg class="date-sun" aria-hidden="true">
        <use href="#i-sun"></use>
      </svg>
      <span>18</span>
      <div>
        OCTUBRE
        <br />
        <b>SÁBADO Y DOMINGO</b>
        <br />
        2026
      </div>
    </div>
    <p class="fogones-description reveal">
      La noche más oriental, en el Cerro Artigas.
      <br />
      El canto <strong>«A Don José»</strong>, un momento único para los orientales.
      <br />
      Dos jornadas de música y tradición con entrada gratuita.
    </p>
    <div class="fogones-links reveal">
      <a class="pill-button cream" href="#fogones-programacion">
        Ver la programación{' '}
        <svg class="icon slant" aria-hidden="true">
          <use href="#i-arrow"></use>
        </svg>
      </a>
      <a
        class="fogones-map"
        href="https://www.google.com/maps/search/?api=1&amp;query=Cerro+Artigas+Minas+Lavalleja+Uruguay"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="icon" aria-hidden="true">
          <use href="#i-pin"></use>
        </svg>{' '}
        Cómo llegar
      </a>
    </div>
  </div>
  <div class="fogones-program" id="fogones-programacion" aria-labelledby="fogones-program-title">
    <div class="fogones-program-heading reveal">
      <p>PROGRAMACIÓN COMPLETA · ENTRADA GRATUITA</p>
      <h3 id="fogones-program-title">
        DOS NOCHES.
        <br />
        <em>UN SOLO FOGÓN.</em>
      </h3>
      <span>{fogones.place} · 17 y 18 de octubre</span>
    </div>
    <div class="fogones-program-grid">
      {fogones.days.map((day) => (
        <article class="fogones-day-card reveal" aria-labelledby={`fogones-day-${day.day}`}>
          <header class="fogones-day-heading">
            <div>
              <span>{day.weekday}</span>
              <strong>{day.day}</strong>
            </div>
            <p>
              OCTUBRE · 2026
              <br />
              CERRO ARTIGAS · MINAS
            </p>
          </header>
          <h4 id={`fogones-day-${day.day}`}>Noche de los Fogones</h4>
          <ol class="fogones-act-list">
            {day.acts.map((act, index) => (
              <>
                {act.civilDate !== day.date &&
                  (index === 0 || day.acts[index - 1]?.civilDate === day.date) && (
                    <li class="fogones-midnight-divider">
                      Madrugada del {civilDayLabel(act.civilDate)}
                    </li>
                  )}
                <li class="fogones-act">
                  <time datetime={`${act.civilDate}T${act.time}:00-03:00`}>{act.time}</time>
                  <span>{act.name}</span>
                </li>
              </>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </div>
  <div class="night-landscape" aria-hidden="true">
    <svg viewBox="0 0 1600 370" preserveAspectRatio="none">
      <path d="M0 210Q207 58 423 209T832 226 1260 115 1600 200V400H0Z" fill="#622744"></path>
      <path d="M0 263Q181 214 322 259T737 231 1122 273 1600 219V400H0Z" fill="#3B1D35"></path>
      <path d="M0 334Q168 232 416 305T834 316 1300 287 1600 325V400H0Z" fill="#201722"></path>
    </svg>
  </div>
</section>
