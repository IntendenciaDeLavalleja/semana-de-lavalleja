---
import { festival } from '../../data/festival';

const { parade } = festival;
const paradeDate = new Intl.DateTimeFormat('es-UY', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'UTC',
})
  .format(new Date(`${parade.date}T12:00:00Z`))
  .replace(',', '')
  .toLocaleUpperCase('es-UY');
const paradeMapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${parade.place} ${parade.city} Lavalleja Uruguay`)}`;
---

<section class="pueblos-section" id="pueblos" aria-labelledby="pueblos-title">
  <div class="section-kicker reveal">
    <span>02 / MÁS ALLÁ DEL ESCENARIO</span>
    <span>LO NUESTRO SE COMPARTE</span>
  </div>
  <div class="pueblos-heading">
    <h2 id="pueblos-title" class="display-heading reveal">
      NO ES SOLO
      <br />
      UN LUGAR.
      <br />
      <span>
        ES LO QUE
        <br />
        NOS UNE.
      </span>
    </h2>
    <div class="pueblos-art reveal" aria-hidden="true">
      <div class="landscape-medallion">
        <div class="medallion-sun"></div>
        <svg viewBox="0 0 600 600">
          <path d="M-20 390Q100 250 239 350T620 285V620H-20" fill="#F68E5A"></path>
          <path d="M-20 435Q140 340 311 394T620 375V620H-20" fill="#E74475"></path>
          <path d="M-20 515Q181 370 377 462T620 454V620H-20" fill="#862E42"></path>
          <path d="M-20 568Q175 443 374 531T620 520V620H-20" fill="#572447"></path>
          <path
            d="M290 602C454 529 168 460 315 397"
            fill="none"
            stroke="#F2CB5D"
            stroke-width="2"
            stroke-dasharray="4 9"
          ></path>
        </svg>
        <span class="medallion-word">LAVALLEJA</span>
      </div>
      <span class="art-note">CADA PUEBLO, UNA FORMA DE ENCONTRARNOS.</span>
    </div>
  </div>
  <div class="pueblos-cards">
    <article class="local-card reveal">
      <div class="card-topline">
        <span>EN TODO EL DEPARTAMENTO</span>
        <svg class="icon" aria-hidden="true">
          <use href="#i-sun"></use>
        </svg>
      </div>
      <h3>
        Días de
        <br />
        los Pueblos.
      </h3>
      <p>
        Actividades festivas y culturales en cada pago. Porque esta fiesta también se vive en
        nuestros pueblos.
      </p>
      <span class="status-chip">Fechas y programación por anunciar</span>
      <a
        class="text-button"
        href="https://www.instagram.com/semanadelavalleja/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Seguí las novedades{' '}
        <svg class="icon slant" aria-hidden="true">
          <use href="#i-arrow"></use>
        </svg>
      </a>
    </article>
    <article class="local-card parade-card reveal">
      <div class="card-topline">
        <span>{paradeDate}</span>
        <span class="small-date">{parade.date.slice(-2)}</span>
      </div>
      <h3>
        La tradición
        <br />
        sale a la calle.
      </h3>
      <p>
        Desfile tradicional por {parade.place}, en {parade.city}. Un encuentro con nuestra
        identidad.
      </p>
      <span class="status-chip">
        <time datetime={`${parade.date}T${parade.time}:00-03:00`}>{parade.time} h</time> ·{' '}
        {parade.place}, {parade.city}
      </span>
      <a class="text-button" href={paradeMapHref} target="_blank" rel="noopener noreferrer">
        Ubicá {parade.place}{' '}
        <svg class="icon slant" aria-hidden="true">
          <use href="#i-arrow"></use>
        </svg>
      </a>
    </article>
  </div>
</section>
