---
import ProgramPageList from '../../components/program/ProgramPageList.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { festival } from '../../data/festival';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, getBuildSite } from '../../lib/urls';

const title = 'Programación completa · 53.ª Semana de Lavalleja';
const description =
  'Horarios y artistas de la Semana de Lavalleja en el Parque Rodó y la Noche de los Fogones en el Cerro Artigas.';
const site = getBuildSite();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: absoluteUrl('/programacion/', site.url),
  inLanguage: 'es-UY',
};
---

<BaseLayout {title} {description} pathname="/programacion/">
  <Fragment slot="head">
    <StructuredData data={structuredData} />
  </Fragment>
  <main class="program-page">
    <p class="eyebrow">MINAS, LAVALLEJA · ENTRADA GRATUITA</p>
    <h1>Programación completa.</h1>
    <p class="program-page-intro">
      Siete jornadas, 50 actuaciones y dos escenarios. Los horarios de madrugada se presentan dentro
      de la noche editorial correspondiente y cada horario conserva su fecha civil real.
    </p>
    <nav class="program-page-nav" aria-label="Jornadas">
      {festival.days.map((day) => (
        <a href={`/programacion/${day.date}/`}>
          {day.short} {String(day.day).padStart(2, '0')}
        </a>
      ))}
      {festival.fogones.days.map((day) => (
        <a href={`#program-${day.date}`}>
          {day.short} {day.day} · Fogones
        </a>
      ))}
    </nav>
    <ProgramPageList days={festival.days} venue="el Parque Rodó de Minas" />
    <p class="eyebrow">NOCHE DE LOS FOGONES · CERRO ARTIGAS</p>
    <ProgramPageList
      days={festival.fogones.days}
      venue="el Cerro Artigas de Minas"
      linked={false}
    />
    <p>
      <a class="text-button" href="/#recorrido">
        ← Volver al recorrido animado
      </a>
    </p>
  </main>
</BaseLayout>
